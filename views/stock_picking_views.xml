<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_picking_form_document_smart_links" model="ir.ui.view">
        <field name="name">stock.picking.form.document.smart.links</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button
                    name="action_view_smart_purchase_orders"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-shopping-cart"
                    attrs="{'invisible': [('smart_purchase_order_count', '=', 0)]}"
                >
                    <field name="smart_purchase_order_count" widget="statinfo" string="Purchase Orders"/>
                </button>
                <button
                    name="action_view_smart_vendor_bills"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-file-text-o"
                    attrs="{'invisible': [('smart_vendor_bill_count', '=', 0)]}"
                >
                    <field name="smart_vendor_bill_count" widget="statinfo" string="Vendor Bills"/>
                </button>
                <button
                    name="action_view_smart_payments"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-money"
                    attrs="{'invisible': [('smart_payment_count', '=', 0)]}"
                >
                    <field name="smart_payment_count" widget="statinfo" string="Payments"/>
                </button>
                <button
                    name="action_view_smart_account_moves"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-file-text-o"
                    attrs="{'invisible': [('smart_account_move_count', '=', 0)]}"
                >
                    <field name="smart_account_move_count" widget="statinfo" string="Accounting Documents"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
