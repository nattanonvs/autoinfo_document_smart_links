<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_document_smart_links" model="ir.ui.view">
        <field name="name">res.partner.form.document.smart.links</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button
                    name="action_view_smart_sale_orders"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-shopping-cart"
                    attrs="{'invisible': [('smart_sale_order_count', '=', 0)]}"
                >
                    <field name="smart_sale_order_count" widget="statinfo" string="Sale Orders"/>
                </button>
                <button
                    name="action_view_smart_deliveries"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-truck"
                    attrs="{'invisible': [('smart_delivery_count', '=', 0)]}"
                >
                    <field name="smart_delivery_count" widget="statinfo" string="Deliveries"/>
                </button>
                <button
                    name="action_view_smart_customer_invoices"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-file-text-o"
                    attrs="{'invisible': [('smart_customer_invoice_count', '=', 0)]}"
                >
                    <field name="smart_customer_invoice_count" widget="statinfo" string="Customer Invoices"/>
                </button>
                <button
                    name="action_view_smart_customer_credit_notes"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-undo"
                    attrs="{'invisible': [('smart_customer_credit_note_count', '=', 0)]}"
                >
                    <field
                        name="smart_customer_credit_note_count"
                        widget="statinfo"
                        string="Customer Credit Notes"
                    />
                </button>
                <button
                    name="action_view_smart_customer_payments"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-money"
                    attrs="{'invisible': [('smart_customer_payment_count', '=', 0)]}"
                >
                    <field
                        name="smart_customer_payment_count"
                        widget="statinfo"
                        string="Customer Payments"
                    />
                </button>
                <button
                    name="action_view_smart_purchase_orders"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-shopping-cart"
                    attrs="{'invisible': [('smart_purchase_order_count', '=', 0)]}"
                >
                    <field name="smart_purchase_order_count" widget="statinfo" string="Purchase Orders"/>
                </button>
                <button
                    name="action_view_smart_vendor_bills"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-file-text-o"
                    attrs="{'invisible': [('smart_vendor_bill_count', '=', 0)]}"
                >
                    <field name="smart_vendor_bill_count" widget="statinfo" string="Vendor Bills"/>
                </button>
                <button
                    name="action_view_smart_payments"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-money"
                    attrs="{'invisible': [('smart_payment_count', '=', 0)]}"
                >
                    <field name="smart_payment_count" widget="statinfo" string="Payments"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
