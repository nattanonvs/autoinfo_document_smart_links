<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_document_smart_links" model="ir.ui.view">
        <field name="name">sale.order.form.document.smart.links</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button
                    name="action_view_smart_credit_notes"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-file-text-o"
                    attrs="{'invisible': [('smart_credit_note_count', '=', 0)]}"
                >
                    <field name="smart_credit_note_count" widget="statinfo" string="Credit Notes"/>
                </button>
                <button
                    name="action_view_smart_debit_notes"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-file-text-o"
                    attrs="{'invisible': [('smart_debit_note_count', '=', 0)]}"
                >
                    <field name="smart_debit_note_count" widget="statinfo" string="Debit Notes"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
