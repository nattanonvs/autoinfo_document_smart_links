<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_document_smart_links" model="ir.ui.view">
        <field name="name">account.move.form.document.smart.links</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button
                    name="action_view_smart_sale_orders"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-shopping-cart"
                    attrs="{'invisible': [('smart_sale_order_count', '=', 0)]}"
                >
                    <field name="smart_sale_order_count" widget="statinfo" string="Sale Orders"/>
                </button>
                <button
                    name="action_view_smart_deliveries"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-truck"
                    attrs="{'invisible': [('smart_delivery_count', '=', 0)]}"
                >
                    <field name="smart_delivery_count" widget="statinfo" string="Deliveries"/>
                </button>
                <button
                    name="action_view_smart_adjustments"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-exchange"
                    attrs="{'invisible': [('smart_adjustment_count', '=', 0)]}"
                >
                    <field name="smart_adjustment_count" widget="statinfo" string="Adjustments"/>
                </button>
                <button
                    name="action_view_smart_purchase_orders"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-shopping-cart"
                    attrs="{'invisible': [('smart_purchase_order_count', '=', 0)]}"
                >
                    <field name="smart_purchase_order_count" widget="statinfo" string="Purchase Orders"/>
                </button>
                <button
                    name="action_view_smart_receipts"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-truck"
                    attrs="{'invisible': [('smart_receipt_count', '=', 0)]}"
                >
                    <field name="smart_receipt_count" widget="statinfo" string="Receipts"/>
                </button>
                <button
                    name="action_view_smart_payments"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-money"
                    attrs="{'invisible': [('smart_payment_count', '=', 0)]}"
                >
                    <field name="smart_payment_count" widget="statinfo" string="Payments"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
